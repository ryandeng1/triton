diff --git a/test/Triton/loop-invariant-code-motion.mlir b/test/Triton/loop-invariant-code-motion.mlir
index cc80c2bf3..6aeed0614 100644
--- a/test/Triton/loop-invariant-code-motion.mlir
+++ b/test/Triton/loop-invariant-code-motion.mlir
@@ -181,3 +181,190 @@ tt.func @do_not_hoist_from_for_with_licm_disabled(%lb: i32, %ub: i32, %step: i32
   } {llvm.loop_annotation = #llvm.loop_annotation<licm = <disable = true>>}
   tt.return %result : i32
