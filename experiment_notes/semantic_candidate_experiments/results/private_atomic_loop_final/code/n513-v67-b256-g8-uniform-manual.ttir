      %offs = arith.muli %block_id, %c256_i32 : i32 loc(#loc23)
      %offs_2 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32> loc(#loc24)
      %offs_3 = tt.splat %offs : i32 -> tensor<256xi32> loc(#loc23)
      %offs_4 = arith.addi %offs_3, %offs_2 : tensor<256xi32> loc(#loc23)
      %mask = tt.splat %N : i32 -> tensor<256xi32> loc(#loc25)
      %mask_5 = arith.cmpi slt, %offs_4, %mask : tensor<256xi32> loc(#loc25)
      %idx = tt.splat %indices_ptr : !tt.ptr<i64> -> tensor<256x!tt.ptr<i64>> loc(#loc26)
      %idx_6 = tt.addptr %idx, %offs_4 : tensor<256x!tt.ptr<i64>>, tensor<256xi32> loc(#loc26)
      %idx_7 = tt.load %idx_6, %mask_5, %cst : tensor<256x!tt.ptr<i64>> loc(#loc27)
      %idx_8 = arith.trunci %idx_7 : tensor<256xi64> to tensor<256xi32> loc(#loc27)
      %valid = tt.splat %padding_idx : i32 -> tensor<256xi32> loc(#loc28)
      %valid_9 = arith.cmpi ne, %idx_8, %valid : tensor<256xi32> loc(#loc28)
      %valid_10 = arith.andi %mask_5, %valid_9 : tensor<256xi1> loc(#loc29)
      %valid_11 = arith.cmpi sge, %idx_8, %cst_1 : tensor<256xi32> loc(#loc30)
      %valid_12 = arith.andi %valid_10, %valid_11 : tensor<256xi1> loc(#loc29)
      %valid_13 = tt.splat %num_weights : i32 -> tensor<256xi32> loc(#loc31)
      %valid_14 = arith.cmpi slt, %idx_8, %valid_13 : tensor<256xi32> loc(#loc31)
      %valid_15 = arith.andi %valid_12, %valid_14 : tensor<256xi1> loc(#loc29)
      %0 = tt.splat %counts_ptr : !tt.ptr<i32> -> tensor<256x!tt.ptr<i32>> loc(#loc14)
      %1 = tt.addptr %0, %idx_8 : tensor<256x!tt.ptr<i32>>, tensor<256xi32> loc(#loc14)
      %2 = tt.atomic_rmw add, relaxed, gpu, %1, %cst_0, %valid_15 : (tensor<256x!tt.ptr<i32>>, tensor<256xi32>, tensor<256xi1>) -> tensor<256xi32> loc(#loc15)
