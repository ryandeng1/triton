module {
  tt.func public @_embedding_dense_backward_count_kernel_relaxed(%indices_ptr: !tt.ptr<i64> {tt.divisibility = 16 : i32} loc("indices_ptr"(#loc)), %counts_ptr: !tt.ptr<i32> {tt.divisibility = 16 : i32} loc("counts_ptr"(#loc)), %N: i32 loc("N"(#loc)), %num_weights: i32 loc("num_weights"(#loc)), %padding_idx: i32 {tt.divisibility = 16 : i32} loc("padding_idx"(#loc))) attributes {noinline = false} {
    %cst = arith.constant dense<0> : tensor<256xi64> loc(#loc1)
    %c3_i32 = arith.constant 3 : i32 loc(#loc2)
    %cst_0 = arith.constant dense<1> : tensor<256xi32> loc(#loc1)
    %cst_1 = arith.constant dense<0> : tensor<256xi32> loc(#loc1)
